# Database
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname

# JWT
JWT_SECRET=your-very-secret-jwt-key-change-this-in-production
SESSION_SECRET=your-very-secret-session-key-change-this-in-production

# Frontend URL
CLIENT_URL=http://localhost:3000

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# Email
EMAIL_FROM=Book Store <noreply@bookstore.com>

# Server
PORT=5000
NODE_ENV=development

# VNPAY Configuration
VNPAY_TMN_CODE=vnpay_tmn_code
VNPAY_HASH_SECRET=vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:5000/api/payments/vnpay/return
VNPAY_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_LOCALE=en